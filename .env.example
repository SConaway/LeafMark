# LeafMark configuration — copy to .env for local `go run`, or to a
# separately-mounted secrets file referenced by LEAFMARK_ENV_FILE in
# production (see docker-compose.yml). Never commit a filled-in copy.
#
# All of these can also be set as plain environment variables instead —
# LEAFMARK_ENV_FILE only fills in whatever isn't already set in the
# environment, so a docker-compose `environment:` entry always wins over
# this file for the same key.

# --- Goodreads ------------------------------------------------------------
# Your Goodreads login email/password. LeafMark drives a real headless
# Chromium through Goodreads' sign-in form to obtain a fresh session cookie
# (the write-path cookie expires roughly every 24h, and re-deriving it this
# way is the whole reason a browser is in the picture at all — see the
# project plan for why a raw HTTP login POST isn't feasible). This is your
# actual account password; treat this file like any other credential.
GOODREADS_USER=you@example.com
GOODREADS_PASSWORD=

# Your numeric Goodreads user ID (find it in your profile URL:
# goodreads.com/user/show/NNNNNNNN-your-name). Used both to fetch your
# want-to-read/currently-reading shelves (public RSS feed — your shelves
# must be set to public for this to work) and to load a page for CSRF
# token scraping before pushing progress.
GOODREADS_USER_ID=

# --- KOReader sync server (gh:nperez0111/koreader-sync) -------------------
KOREADER_SYNC_URL=https://kosync.example.com
KOREADER_SYNC_USERNAME=
KOREADER_SYNC_PASSWORD=

# --- ntfy -------------------------------------------------------------------
# Full topic URL, e.g. https://ntfy.sh/your-private-topic-name or your own
# self-hosted server. This is where match-needed notifications (with
# tap-to-confirm action buttons) and session-expired alerts go.
NTFY_URL=https://ntfy.sh/your-topic

# --- LeafMark itself --------------------------------------------------------
# The public (Tailscale) HTTPS base URL LeafMark is reachable at. Must be
# https:// — ntfy's tap-to-confirm action buttons silently won't fire on
# iOS otherwise. Used to build those action URLs and WebUI links.
LEAFMARK_BASE_URL=https://leafmark.your-tailnet.ts.net

# How often to poll the KOReader sync server for progress updates.
POLL_INTERVAL=5m

# Fuzzy-match confidence cutoff (0.0-1.0) for auto-confirming a shelf match
# without asking. Higher = fewer wrong auto-matches, more ntfy prompts.
MATCH_THRESHOLD=0.8

# Where the SQLite file lives. In Docker this should be inside the mounted
# /data volume (see docker-compose.yml).
DB_PATH=./leafmark.db

# Address the WebUI / confirm endpoint listens on.
LISTEN_ADDR=:8080
